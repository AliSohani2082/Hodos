# Agent-job sandbox image (PRD AI-1 / §9.4 "agent-job" profile).
# Deliberately NOT derived from any app image: only a Node base, the agent CLIs + their ACP adapters,
# and a handful of everyday tools an agent (or an injected agent) would expect to find.
FROM docker.io/library/node:24-slim

ARG CLAUDE_AGENT_ACP=0.91.0
ARG CODEX_ACP=2.2.2
ARG CLAUDE_CODE=2.1.301
ARG CODEX_CLI=0.160.1

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates git ripgrep procps iproute2 netcat-openbsd dnsutils python3 \
 && rm -rf /var/lib/apt/lists/*

# ACP adapters (bring their own claude-agent-sdk / @openai/codex) plus the standalone CLIs, so the
# flag tests (ALI-58) can drive `claude` / `codex` directly. Installed root-owned, read-only at runtime.
RUN npm install -g --prefix /opt/agent --no-audit --no-fund \
      @agentclientprotocol/claude-agent-acp@${CLAUDE_AGENT_ACP} \
      @agentclientprotocol/codex-acp@${CODEX_ACP} \
      @anthropic-ai/claude-code@${CLAUDE_CODE} \
      @openai/codex@${CODEX_CLI} \
 && npm cache clean --force
ENV PATH=/opt/agent/bin:$PATH

# Non-root user. Home is a tmpfs at runtime (see scripts/lib.sh), so nothing persists between jobs.
RUN groupadd -g 10001 agent && useradd -u 10001 -g 10001 -m -d /home/agent -s /bin/bash agent \
 && mkdir -p /workspace && chown 10001:10001 /workspace
USER 10001:10001
WORKDIR /workspace
# No ENTRYPOINT/CMD secrets; the client chooses what to exec (claude-agent-acp | codex-acp | bash for escape tests).
CMD ["bash"]
