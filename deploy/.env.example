# Copy to .env and edit. Keep .env private: it holds your model key. It is ignored by git.

# The model key for DeepSeek Harness. Never put it in the image or the repository.
DEEPSEEK_API_KEY=

# Where the container's port is published on this machine.
#   127.0.0.1  only this machine (use with an SSH tunnel, or a proxy on this machine)
#   an address of this machine (for example its VPN address): reachable from there
# 0.0.0.0 publishes it on every network this machine is on: only do that behind a firewall.
HODOS_BIND=127.0.0.1
HODOS_PORT=8787

# The address your phone opens, with no token. A proxy or VPN name works as well as an IP.
# Its host is trusted automatically. Use https:// when TLS is added in front or by the next lines.
HODOS_PUBLIC_URL=

# More host names or IPs the phone may use, comma separated (optional).
#HODOS_TRUSTED_HOSTS=

# Serve HTTPS from a certificate (mount the folder in docker-compose.yml first).
#HODOS_TLS_CERT=/certs/fullchain.pem
#HODOS_TLS_KEY=/certs/privkey.pem

# Plain HTTP on a network address sends the session cookie unencrypted. Allow it only when
# every device reaches this over a VPN or another encrypted private network.
#HODOS_ALLOW_PLAIN_HTTP=1

# The interface plugins to add: chess code math language, or none.
#HODOS_PLUGINS=chess code math language
